[Unit]
Description=NetAccess Tokyo Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/tokyo-proxy/tokyo_proxy.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 安全加固（可选）
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
